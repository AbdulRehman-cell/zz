# Version control
.git
.github
.gitignore

# Docs (not needed inside image)
DEPLOY.md
README.md
*.md

# Environment / secrets
.env
.env.*
!.env.example

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode
.idea

# Docker-related
Dockerfile
docker-compose.yml
docker-compose.override.yml

# Node artifacts (should not exist, but ignore defensively)
node_modules
npm-debug.log
yarn-error.log
package.json
package-lock.json
yarn.lock

# CI/platform config not needed in image
render.yaml