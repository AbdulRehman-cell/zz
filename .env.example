# ---------------------------------------------------------------------------
# .env.example — Static site environment variables
# This is a static HTML/CSS/JS site: NO runtime secrets or API keys required
# for the app itself. Variables below are optional and used only for
# tooling/CI/CD convenience.
# ---------------------------------------------------------------------------

# Environment label surfaced in docker-compose (informational only)
SITE_ENV=production

# Render deploy hook URL used by GitHub Actions to trigger deploys.
# Get this from: Render Dashboard -> your service -> Settings -> Deploy Hook
# Set this as a GitHub Actions secret named RENDER_DEPLOY_HOOK_URL, NOT here.
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxxxxxxx?key=xxxxxxxxxx