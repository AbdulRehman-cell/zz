# -----------------------------------------------------------------------------
# Environment variables for the static site container
# This is a plain HTML/CSS/JS app — it needs almost no runtime configuration.
# Copy this file to .env for local docker-compose usage (not required by Render).
# -----------------------------------------------------------------------------

# Port nginx listens on inside the container (must match EXPOSE in Dockerfile
# and the healthCheckPath port in render.yaml). Default: 8080
NGINX_PORT=8080

# -----------------------------------------------------------------------------
# CI/CD secrets (set these in GitHub repo settings -> Secrets and variables,
# NOT in this file):
#
# RENDER_DEPLOY_HOOK_URL   - Deploy hook URL from Render dashboard
#                            (Service -> Settings -> Deploy Hook)
# -----------------------------------------------------------------------------