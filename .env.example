# ------------------------------------------------------------------
# Environment variables for static-site deployment
# This is a static HTML/CSS/JS site — no application secrets needed.
# Copy this file to .env and adjust values as needed for local runs.
# ------------------------------------------------------------------

# Host port to expose the site on when running via docker-compose
# (container always listens internally on 8080)
PORT=8080

# Timezone used inside the container (affects log timestamps)
TZ=UTC

# ------------------------------------------------------------------
# CI/CD (set these as GitHub Actions "Repository Secrets", NOT here)
# ------------------------------------------------------------------
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxx?key=xxxxxxxx